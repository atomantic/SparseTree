{
  "name": "@fsf/server",
  "version": "0.8.3",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && cp src/db/*.sql dist/db/ && if [ -d src/db/postgres-migrations ]; then mkdir -p dist/db/postgres-migrations && cp -R src/db/postgres-migrations/. dist/db/postgres-migrations/; fi",
    "start": "tsx src/index.ts"
  },
  "dependencies": {
    "@fsf/shared": "*",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "playwright": "^1.61.1",
    "portos-ai-toolkit": "^0.8.4",
    "tsx": "^4.19.2",
    "ulid": "^3.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "~5.0.7",
    "@types/node": "^26.0.1",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
